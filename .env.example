# ===========================================
# SMARTPROPERTY - ROOT ENVIRONMENT
# ===========================================
# This file covers ONLY the variables docker-compose.yml interpolates at the
# root level. Everything else lives with the service that owns it:
#
#   backend/.env.example       API, database, JWT, mail, OAuth, payments
#   frontend/.env.example      VITE_* build-time variables
#   ai-services/.env.example   FastAPI service settings
#
# Copy to .env and fill in. Never commit the filled-in .env.

# Google OAuth - passed through to the backend container
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Mapbox - public token, injected into the frontend build
MAPBOX_TOKEN=your_mapbox_public_token

# reCAPTCHA v2 site key - public, rendered in the browser
# The matching secret key belongs in backend/.env
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
